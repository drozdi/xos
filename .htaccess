RewriteEngine On

RewriteRule ^api(?:/.*)?$ server/public/index.php [L,QSA]

RewriteRule ^assets/vite.svg$ client/dist/assets/vite.svg [L,QSA]
RewriteRule ^assets/(.*)$ client/dist/assets/$1 [L,QSA]

RewriteRule ^$ client/dist/index.html [L]

# Do not serve arbitrary files from the repository root (env, keys, uploads).
RewriteRule ^ client/dist/index.html [L]