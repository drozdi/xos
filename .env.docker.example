# Copy to .env.docker next to docker-compose.yml. Do not commit .env.docker.
APP_SECRET=
SYMFONY_TRUSTED_PROXIES=private_ranges
JWT_PASSPHRASE=
DATABASE_URL=mysql://xos:replace-me@mysql:3306/xos?serverVersion=8
MYSQL_DATABASE=xos
MYSQL_USER=xos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MERCURE_PUBLIC_URL=http://localhost:9080
MERCURE_JWT_SECRET=
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
SSH_GATEWAY_SECRET=
SSH_GATEWAY_PUBLIC_URL=ws://localhost:7681
# Comma-separated browser origins. Empty allows any. Use wss:// in this URL when a proxy terminates TLS.
SSH_GATEWAY_ORIGINS=
SSH_SECRET_KEY=
GITHUB_TOKEN_SECRET=
TS_TOKEN_SECRET=
INCCOM_FNS_SECRET=
YANDEX_DISK_TOKEN_SECRET=
PKB_AT_REST_SECRET=
