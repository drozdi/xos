{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"allowJs": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@inccom/*": ["./src/features/inccom/*"]
		},
		"types": ["vite/client"]
	},
	"include": ["src"],
	"exclude": [
		"**/__test__/**",
		"**/*.stories.tsx",
		"src/features/inccom/features/qr-scanner/**",
		"src/features/inccom/app/providers/**",
		"src/features/inccom/shared/internal/**",
		"src/features/inccom/shared/ui/item/**",
		"src/features/inccom/shared/ui/list/**",
		"src/features/inccom/shared/ui/progress/**",
		"src/features/inccom/shared/ui/table/**",
		"src/features/inccom/shared/utils/Axios-Interceptor.ts",
		"src/features/inccom/shared/utils/fns.ts",
		"src/features/inccom/shared/utils/is.ts",
		"src/features/inccom/shared/utils/factory-multi-select.tsx",
		"src/features/inccom/shared/zustand/**"
	]
}
