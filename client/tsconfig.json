{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"allowJs": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] },
		"types": ["vite/client"]
	},
	"include": ["src"]
}
