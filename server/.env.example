APP_ENV=dev
APP_SECRET=change_me

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:@127.0.0.1:3306/xos?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> ssh ###
# Dedicated key for SSH secrets. Until it is set, encryption still uses APP_SECRET.
# After setting it, run: php bin/console ssh:reencrypt-secrets
# SSH_SECRET_KEY=
# SSH_GATEWAY_SECRET=
# SSH_GATEWAY_PUBLIC_URL=ws://127.0.0.1:7681
###< ssh ###

###> mercure ###
# MERCURE_URL=http://127.0.0.1:9080
# MERCURE_PUBLIC_URL=http://127.0.0.1:9080
# MERCURE_JWT_SECRET=
###< mercure ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=xos_jwt_pass
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
# Includes http://localhost:5173 (Vite dev server)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> explorer yandex disk ###
# Optional. Without it OAuth tokens are stored in plaintext (dev only).
# YANDEX_DISK_TOKEN_SECRET=
###< explorer yandex disk ###
